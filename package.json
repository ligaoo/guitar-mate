{
  "name": "guitar-mate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-model.mjs && node scripts/gen-sw.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "prebuild": "node scripts/copy-model.mjs && node scripts/gen-sw.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "host": "npm run build && vite preview --host --port 4173",
    "serve:subpath": "node scripts/serve-subpath.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "test": "npm run typecheck && node scripts/run-tests.mjs",
    "eval": "node scripts/eval-transcription.mjs",
    "eval:bp": "node scripts/eval-transcription.mjs --engine=bp",
    "transcribe": "node scripts/run-transcribe.mjs",
    "auto": "node scripts/run-auto.mjs",
    "calibrate": "node scripts/run-calibrate.mjs",
    "sweep": "node scripts/run-sweep.mjs"
  },
  "dependencies": {
    "@spotify/basic-pitch": "^1.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "~5.6.2",
    "vite": "^5.4.8"
  }
}
